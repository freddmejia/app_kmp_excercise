import botix.dev.myweeklyroutinegymapp.domain.model.MeasurementType;
import kotlin.Boolean;

-- Catalogue of user activities. Upstream of WorkoutSession and Goals: both
-- consume this list. `measurement_type` is the contract that decides which
-- logging form applies and which metrics are possible downstream.
CREATE TABLE activity (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    name             TEXT NOT NULL,
    measurement_type TEXT AS MeasurementType NOT NULL,
    icon             TEXT,
    color            TEXT,
    -- Optional, user-owned grouping. ON DELETE SET NULL: removing a category
    -- uncategorises its activities instead of deleting them, which is why the
    -- delete is unrestricted (see ActivityCategory.sq).
    category_id      INTEGER REFERENCES activity_category(id) ON DELETE SET NULL,
    is_archived      INTEGER AS Boolean NOT NULL DEFAULT 0,
    is_seed          INTEGER AS Boolean NOT NULL DEFAULT 0,
    created_at       INTEGER NOT NULL
);

-- Integrity rule 4: name is unique among non-archived activities, so two active
-- "Running" cannot coexist. Archived rows are exempt and keep their history.
CREATE UNIQUE INDEX activity_active_name_unique ON activity(name) WHERE is_archived = 0;

CREATE INDEX activity_archived_idx ON activity(is_archived);

CREATE INDEX activity_category_idx ON activity(category_id);

selectAll:
SELECT * FROM activity ORDER BY name ASC;

selectActive:
SELECT * FROM activity WHERE is_archived = 0 ORDER BY name ASC;

selectArchived:
SELECT * FROM activity WHERE is_archived = 1 ORDER BY name ASC;

selectById:
SELECT * FROM activity WHERE id = ?;

-- Picker default order: most-used first (integrity note §4), active only.
selectActiveByUsage:
SELECT a.*, COUNT(ws.id) AS session_count
FROM activity a
LEFT JOIN workout_session ws ON ws.activity_id = a.id
WHERE a.is_archived = 0
GROUP BY a.id
ORDER BY session_count DESC, a.name ASC;

-- Guards the "measurement_type is immutable once it has history" rule and the
-- restricted hard delete. Callers must check this before either operation.
countSessionsFor:
SELECT COUNT(*) FROM workout_session WHERE activity_id = ?;

-- Lets the create/rename flow report "name already in use" as a normal form error
-- instead of letting the unique index throw at insert time.
countActiveWithName:
SELECT COUNT(*) FROM activity WHERE is_archived = 0 AND name = :name AND id != :excludingId;

insert:
INSERT INTO activity (name, measurement_type, icon, color, category_id, is_archived, is_seed, created_at)
VALUES (?, ?, ?, ?, ?, 0, ?, ?);

-- Identity only. measurement_type is deliberately absent: changing it with
-- sessions on record would strand that data in an incompatible model.
updateIdentity:
UPDATE activity SET name = ?, icon = ?, color = ?, category_id = ? WHERE id = ?;

-- Reassigning from a list row, where the form's other fields are not in hand.
-- NULL moves the activity back to uncategorised.
setCategory:
UPDATE activity SET category_id = ? WHERE id = ?;

-- Called when a category is archived rather than deleted: archiving hides it from
-- the pickers, so leaving activities pointing at an invisible category would strand
-- them in a filter nothing can select.
clearCategory:
UPDATE activity SET category_id = NULL WHERE category_id = ?;

-- Only legal while countSessionsFor() = 0; enforce in the repository.
updateMeasurementType:
UPDATE activity SET measurement_type = ? WHERE id = ?;

setArchived:
UPDATE activity SET is_archived = ? WHERE id = ?;

-- Hard delete, restricted: only when no session and no goal references it.
deleteById:
DELETE FROM activity WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
