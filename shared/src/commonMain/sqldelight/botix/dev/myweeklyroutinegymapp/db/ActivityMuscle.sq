-- Which muscles an activity targets. Optional, many-to-many, and purely a default:
-- it scopes the log picker, it does not constrain what may be logged.
--
-- Links point at leaves, never at a group, for the same reason sessions do
-- (TRAINING.md §3): one level of reference means volume aggregates uniformly with no
-- special branches. Ticking a whole group in the UI links its leaves.
--
-- The trade-off of storing leaves: a leaf added to a group later is not picked up by
-- activities already linked to that group's other leaves. That is the honest
-- behaviour — "Chest" today and "Chest" after you split it into three are different
-- sets of muscles, and silently widening an activity's scope would be worse.
CREATE TABLE activity_muscle (
    activity_id INTEGER NOT NULL REFERENCES activity(id) ON DELETE CASCADE,
    muscle_id   INTEGER NOT NULL REFERENCES muscle(id) ON DELETE CASCADE,
    -- Composite key: a muscle is linked to an activity once or not at all, and
    -- uniqueness comes free rather than needing its own index.
    PRIMARY KEY (activity_id, muscle_id)
);

-- The reverse lookup (which activities target this muscle) has no covering index
-- from the composite key, which leads on activity_id.
CREATE INDEX activity_muscle_muscle_idx ON activity_muscle(muscle_id);

-- The scoped log picker: same columns and ordering as MuscleCatalog.sq's
-- selectPickerByUsage, so both feed the identical mapper and section grouping.
selectPickerForActivity:
SELECT m.id, m.name, m.group_id, g.name AS group_name, COUNT(sm.id) AS usage_count
FROM activity_muscle am
JOIN muscle m ON m.id = am.muscle_id
JOIN muscle_group g ON g.id = m.group_id
LEFT JOIN session_muscle sm ON sm.muscle_id = m.id
WHERE am.activity_id = ? AND m.is_archived = 0 AND g.is_archived = 0
GROUP BY m.id
ORDER BY g.name ASC, usage_count DESC, m.name ASC;

-- The whole table, for the management screen: it needs a count per row and the exact
-- set for the row being edited, and this answers both from one subscription. Raw
-- ids, archived muscles included — the selection form saves what it shows, so
-- filtering here would quietly drop those links on the next save.
selectAllLinks:
SELECT activity_id, muscle_id FROM activity_muscle;

insertLink:
INSERT OR IGNORE INTO activity_muscle (activity_id, muscle_id) VALUES (?, ?);

deleteLink:
DELETE FROM activity_muscle WHERE activity_id = ? AND muscle_id = ?;

-- Used to replace an activity's whole selection in one transaction.
deleteAllForActivity:
DELETE FROM activity_muscle WHERE activity_id = ?;

-- Called when a muscle is deleted or archived out of existence, so the link does not
-- outlive its target.
deleteAllForMuscle:
DELETE FROM activity_muscle WHERE muscle_id = ?;

-- Same, for every leaf of a group being deleted.
deleteAllForGroup:
DELETE FROM activity_muscle
WHERE muscle_id IN (SELECT id FROM muscle WHERE group_id = ?);
