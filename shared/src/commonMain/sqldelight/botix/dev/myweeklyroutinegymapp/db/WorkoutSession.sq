-- A session: one piece of training, on one day.
--
-- **This is the only thing the app records.** There is no catalogue of named
-- activities to create first and no reusable "chest day" to pick from — a session
-- carries the day it happened, the kind of training it was, and what was worked. See
-- 6.sqm for what was removed and why.
--
-- A STRENGTH session is measured by the session_muscle rows hanging off it — no load,
-- no reps (TRAINING.md §1), the atomic unit is the set, split effective vs. warmup.
--
-- A DISTANCE_TIME session is measured by the two columns below and has no
-- session_muscle rows at all. They are metres and seconds, never km or minutes:
-- units are a display choice, so changing one is formatting rather than a migration.
-- Both are null for every strength session.
CREATE TABLE workout_session (
    -- Which kind of training, and therefore which form it opens. Nullable, and
    -- ON DELETE SET NULL rather than RESTRICT: deleting a category must not be able
    -- to destroy training history, so a session outlives the label on it and the log
    -- screen renders the orphan with a fallback.
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    category_id      INTEGER REFERENCES activity_category(id) ON DELETE SET NULL,
    date_epoch_day   INTEGER NOT NULL,
    notes            TEXT,
    created_at       INTEGER NOT NULL,
    distance_meters  INTEGER,
    duration_seconds INTEGER
);

-- The check IS the row: creating a session_muscle means "I trained this muscle
-- that day". UNIQUE(session_id, muscle_id) makes a muscle appear once per
-- session; working it twice in a day sums into the same row (§2.4).
CREATE TABLE session_muscle (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id     INTEGER NOT NULL REFERENCES workout_session(id) ON DELETE CASCADE,
    muscle_id      INTEGER NOT NULL REFERENCES muscle(id),
    effective_sets INTEGER NOT NULL CHECK (effective_sets >= 1),
    warmup_sets    INTEGER NOT NULL DEFAULT 0 CHECK (warmup_sets >= 0),
    UNIQUE (session_id, muscle_id)
);

CREATE INDEX workout_session_date_idx ON workout_session(date_epoch_day);
CREATE INDEX workout_session_category_idx ON workout_session(category_id);
CREATE INDEX session_muscle_session_idx ON session_muscle(session_id);
CREATE INDEX session_muscle_muscle_idx ON session_muscle(muscle_id);

-- ---------- sessions ----------

selectSessionById:
SELECT * FROM workout_session WHERE id = ?;

selectSessionsInRange:
SELECT * FROM workout_session
WHERE date_epoch_day BETWEEN :fromDay AND :toDay
ORDER BY date_epoch_day DESC, created_at DESC;

-- Everything the day view's cards need, in one row each: which kind of training, its
-- measurement type, and the totals, without a follow-up query per session.
--
-- Both joins are LEFT. On session_muscle so a log with nothing ticked yet still
-- appears — it was created deliberately, and hiding it would leave no way to reopen
-- or delete it, only an invisible row inflating every count that scans sessions. On
-- activity_category because category_id is nullable: a session whose category was
-- deleted still happened, and an INNER JOIN would erase it from the day it was
-- logged on.
--
-- measurement_type comes along so the day list knows which shape to render without
-- inferring it from which columns happen to be null.
selectDaySummaries:
SELECT ws.id, ws.category_id, c.name AS category_name, c.measurement_type,
       ws.date_epoch_day, ws.notes,
       -- CAST because SQLDelight types a bare SUM() as REAL; the rest of the
       -- schema does the same so set counts stay Long end to end.
       CAST(COALESCE(SUM(sm.effective_sets), 0) AS INTEGER) AS effective_sets,
       CAST(COALESCE(SUM(sm.warmup_sets), 0) AS INTEGER) AS warmup_sets,
       COUNT(sm.id) AS muscle_count,
       ws.distance_meters, ws.duration_seconds
FROM workout_session ws
LEFT JOIN activity_category c ON c.id = ws.category_id
LEFT JOIN session_muscle sm ON sm.session_id = ws.id
WHERE ws.date_epoch_day = ?
GROUP BY ws.id
ORDER BY ws.created_at ASC;

-- Which muscles each of a day's logs worked, by name.
--
-- The day card lists them rather than counting them: "Biceps · Chest" says what the
-- session was in a way "2 muscles" cannot, and it is the only thing distinguishing two
-- Gym logs on the same day now that neither carries a name.
--
-- One query for the whole day rather than one per row — the list is a LazyColumn and a
-- per-row query would fire as each card scrolled into view.
selectDayMuscles:
SELECT sm.session_id, m.name AS muscle_name
FROM session_muscle sm
JOIN workout_session ws ON ws.id = sm.session_id
JOIN muscle m ON m.id = sm.muscle_id
WHERE ws.date_epoch_day = ?
ORDER BY m.name ASC;

-- One session, with its category resolved — what the entry screen opens on.
--
-- Keyed by id rather than by (category, day) because a day may hold several logs of
-- the same kind: two Gym sessions on one Tuesday are two rows, told apart by what is
-- in them, so the pair no longer identifies anything.
selectSessionDetailById:
SELECT ws.id, ws.category_id, c.name AS category_name, c.measurement_type,
       ws.date_epoch_day, ws.notes, ws.distance_meters, ws.duration_seconds
FROM workout_session ws
LEFT JOIN activity_category c ON c.id = ws.category_id
WHERE ws.id = ?;

insertSession:
INSERT INTO workout_session (category_id, date_epoch_day, notes, created_at)
VALUES (?, ?, ?, ?);

-- Deleting a category strips the label off its logs. Explicit rather than relying on
-- ON DELETE SET NULL, which only fires while PRAGMA foreign_keys is on — a per-driver
-- setting, and off in the JDBC driver the tests use.
clearCategory:
UPDATE workout_session SET category_id = NULL WHERE category_id = ?;

updateSessionNotes:
UPDATE workout_session SET notes = ? WHERE id = ?;

-- A distance/time session's measurements, set in one write.
--
-- Replaces rather than accumulates, unlike a muscle's sets: two rides in a day are
-- two rides, so the log screen creates a second session for the second one instead of
-- adding its kilometres onto the first. Editing an existing ride therefore means
-- correcting a number, which is a replace.
setSessionDistanceTime:
UPDATE workout_session
SET distance_meters = :distanceMeters, duration_seconds = :durationSeconds
WHERE id = :sessionId;

-- Entries cascade via the FK, provided PRAGMA foreign_keys is on (the driver
-- factory enables it on both platforms).
deleteSession:
DELETE FROM workout_session WHERE id = ?;

-- Paired with deleteSession in one transaction. The FK declares ON DELETE CASCADE,
-- but that only fires while PRAGMA foreign_keys is on — a per-driver setting, true
-- on both shipping platforms and off in the JDBC driver the tests use. Doing it
-- explicitly makes the outcome identical everywhere.
deleteEntriesForSession:
DELETE FROM session_muscle WHERE session_id = ?;

-- ---------- entries ----------

selectEntriesForSession:
SELECT sm.id, sm.session_id, sm.muscle_id, sm.effective_sets, sm.warmup_sets,
       m.name AS muscle_name, g.id AS group_id, g.name AS group_name
FROM session_muscle sm
JOIN muscle m ON m.id = sm.muscle_id
JOIN muscle_group g ON g.id = m.group_id
WHERE sm.session_id = ?
ORDER BY g.name ASC, m.name ASC;

-- Check a muscle: create the entry.
--
-- Summing on repeat cannot be one statement here — ON CONFLICT DO UPDATE needs
-- SQLite 3.24 (API 29+) and minSdk is 24, and INSERT OR REPLACE would overwrite
-- the sets instead of adding to them. The repository therefore reads
-- selectEntry first and calls insertEntry or addToEntry inside a transaction.
insertEntry:
INSERT INTO session_muscle (session_id, muscle_id, effective_sets, warmup_sets)
VALUES (?, ?, ?, ?);

selectEntry:
SELECT * FROM session_muscle WHERE session_id = ? AND muscle_id = ?;

-- Same muscle worked at a second moment in the day: add, do not duplicate (§2.4).
addToEntry:
UPDATE session_muscle
SET effective_sets = effective_sets + :effectiveSets,
    warmup_sets = warmup_sets + :warmupSets
WHERE session_id = :sessionId AND muscle_id = :muscleId;

-- Direct edit of an existing entry (replaces rather than sums).
setEntrySets:
UPDATE session_muscle SET effective_sets = ?, warmup_sets = ?
WHERE session_id = ? AND muscle_id = ?;

-- Unchecking a muscle removes the entry.
deleteEntry:
DELETE FROM session_muscle WHERE session_id = ? AND muscle_id = ?;

sessionTotals:
SELECT CAST(COALESCE(SUM(effective_sets), 0) AS INTEGER) AS total_effective,
       CAST(COALESCE(SUM(warmup_sets), 0) AS INTEGER) AS total_warmup
FROM session_muscle WHERE session_id = ?;

-- ---------- metrics (§9 traceability) ----------

-- Volume per kind of training over a window.
--
-- Only categories with a session in the range come back, which is the filter itself:
-- absence from this result *is* "not trained that week", so a caller needs no second
-- query to work out which rows to drop.
--
-- distinct_days counts days rather than sessions, so two Gym logs on one Tuesday read
-- as one day trained — the frequency question people actually ask.
volumePerCategoryInRange:
SELECT ws.category_id,
       CAST(COALESCE(SUM(sm.effective_sets), 0) AS INTEGER) AS effective_sets,
       CAST(COALESCE(SUM(sm.warmup_sets), 0) AS INTEGER) AS warmup_sets,
       COUNT(DISTINCT ws.date_epoch_day) AS distinct_days,
       COUNT(DISTINCT ws.id) AS session_count,
       -- Null, not zero, when the category has no distance/time sessions in range:
       -- the row then shows sets, and "0 km" would be a measurement it never took.
       -- CAST for the same reason as the set sums above: SQLDelight types a bare
       -- SUM() as REAL. CAST(NULL AS INTEGER) is still NULL, so the "never measured"
       -- case survives the cast intact.
       CAST(SUM(ws.distance_meters) AS INTEGER) AS distance_meters,
       CAST(SUM(ws.duration_seconds) AS INTEGER) AS duration_seconds
FROM workout_session ws
LEFT JOIN session_muscle sm ON sm.session_id = ws.id
WHERE ws.date_epoch_day BETWEEN :fromDay AND :toDay
GROUP BY ws.category_id;

-- Volume per muscle over a window: effective sets, and the days it was trained.
volumePerMuscleInRange:
SELECT m.id AS muscle_id, m.name AS muscle_name, g.id AS group_id, g.name AS group_name,
       CAST(COALESCE(SUM(sm.effective_sets), 0) AS INTEGER) AS effective_sets,
       CAST(COALESCE(SUM(sm.warmup_sets), 0) AS INTEGER) AS warmup_sets,
       COUNT(DISTINCT ws.date_epoch_day) AS distinct_days
FROM session_muscle sm
JOIN workout_session ws ON ws.id = sm.session_id
JOIN muscle m ON m.id = sm.muscle_id
JOIN muscle_group g ON g.id = m.group_id
WHERE ws.date_epoch_day BETWEEN :fromDay AND :toDay
GROUP BY m.id
ORDER BY effective_sets DESC;

-- Group volume = sum of the effective sets of all its leaves, "General" included.
volumePerGroupInRange:
SELECT g.id AS group_id, g.name AS group_name,
       CAST(COALESCE(SUM(sm.effective_sets), 0) AS INTEGER) AS effective_sets,
       CAST(COALESCE(SUM(sm.warmup_sets), 0) AS INTEGER) AS warmup_sets,
       COUNT(DISTINCT ws.date_epoch_day) AS distinct_days
FROM session_muscle sm
JOIN workout_session ws ON ws.id = sm.session_id
JOIN muscle m ON m.id = sm.muscle_id
JOIN muscle_group g ON g.id = m.group_id
WHERE ws.date_epoch_day BETWEEN :fromDay AND :toDay
GROUP BY g.id
ORDER BY effective_sets DESC;

-- Requirement 2: which muscles were NOT trained in the window.
--
-- NOT EXISTS rather than a LEFT JOIN with HAVING SUM(...) = 0, for two reasons:
-- the date filter has to sit inside the subquery or a muscle trained outside the
-- range still counts as trained; and in SQLite a HAVING clause resolves a bare
-- name against the source columns before the SELECT alias, so
-- `HAVING effective_sets = 0` silently binds to session_muscle.effective_sets,
-- which is NULL for unmatched rows and compares false — dropping every row.
untrainedMusclesInRange:
SELECT m.id AS muscle_id, m.name AS muscle_name, g.name AS group_name
FROM muscle m
JOIN muscle_group g ON g.id = m.group_id
WHERE m.is_archived = 0
  AND g.is_archived = 0
  AND NOT EXISTS (
      SELECT 1
      FROM session_muscle sm
      JOIN workout_session ws ON ws.id = sm.session_id
      WHERE sm.muscle_id = m.id
        AND ws.date_epoch_day BETWEEN :fromDay AND :toDay
  )
ORDER BY g.name ASC, m.name ASC;

-- Progression: effective sets per muscle per day, for week-over-week trend.
dailyVolumeForMuscle:
SELECT ws.date_epoch_day, CAST(COALESCE(SUM(sm.effective_sets), 0) AS INTEGER) AS effective_sets
FROM session_muscle sm
JOIN workout_session ws ON ws.id = sm.session_id
WHERE sm.muscle_id = :muscleId AND ws.date_epoch_day BETWEEN :fromDay AND :toDay
GROUP BY ws.date_epoch_day
ORDER BY ws.date_epoch_day ASC;

-- Streaks / gaps / goal windows: the distinct days a kind of training happened.
trainedDaysForCategory:
SELECT DISTINCT date_epoch_day FROM workout_session
WHERE category_id = :categoryId AND date_epoch_day BETWEEN :fromDay AND :toDay
ORDER BY date_epoch_day ASC;

lastInsertRowId:
SELECT last_insert_rowid();
