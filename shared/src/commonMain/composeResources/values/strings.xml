<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale. Compose resources fall back here whenever the device language has
  no values-<lang> folder, so every key must exist in this file even when a
  translation is still missing elsewhere.

  Apostrophes are escaped as \' — the Android string format treats a bare one as a
  quoting character, which silently truncates the rest of the string. The Romance
  translations are full of them.
-->
